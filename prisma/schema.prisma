generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Symbol {
  id          Int        @id @default(autoincrement())
  ticker      String     @unique
  exchange    String // HOSE | HNX | UPCOM
  companyName String?
  sector      String?
  bandPct     Float // 0.07 | 0.10 | 0.15
  kind        String     @default("stock") // stock | fund (chứng chỉ quỹ ETF/IFC)
  active      Boolean    @default(true)
  bars        DailyBar[]
  signals     Signal[]
  trades      Trade[]
  position    Position?
}

model DailyBar {
  id       Int    @id @default(autoincrement())
  symbolId Int
  symbol   Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  date     String // YYYY-MM-DD, giờ VN
  open     Float // nghìn đồng
  high     Float
  low      Float
  close    Float
  volume   Int
  value    Float // close * volume * 1000, đơn vị VND

  @@unique([symbolId, date])
  @@index([symbolId, date])
}

model Strategy {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  type    String // "breakout-20" | "pullback-ma20" | "rsi2-revert"
  params  String // JSON
  enabled Boolean @default(true)
  signals Signal[]
}

model Signal {
  id         Int      @id @default(autoincrement())
  strategyId Int
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  symbolId   Int
  symbol     Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  date       String // phiên phát sinh tín hiệu
  entry      Float
  stop       Float
  target     Float
  qty        Int
  rr         Float
  reason     String?
  plan       String? // vì sao target đó + kỳ vọng số phiên
  buyLow     Float?  // vùng mua an toàn [buyLow, buyHigh]
  buyHigh    Float?
  status     String   @default("new") // new | notified | taken | skipped | expired | filled
  createdAt  DateTime @default(now())
  // Trả bài gợi ý (lib/report/signal-outcome.ts): mô phỏng kế hoạch trên nến ngày sau tín hiệu
  outcome     String? // win | loss | time | missed — null = chưa đủ phiên
  outcomePct  Float? // % net sau phí+thuế
  outcomeR    Float?
  outcomeDate String? // phiên chốt kết quả
  fillPrice   Float?
  exitPrice   Float?
  orders     Order[]
  trades     Trade[]

  @@unique([strategyId, symbolId, date])
  @@index([date, status])
}

model Order {
  id          Int       @id @default(autoincrement())
  signalId    Int?
  signal      Signal?   @relation(fields: [signalId], references: [id])
  side        String // BUY | SELL
  qty         Int
  price       Float
  type        String // LO | MP
  status      String // pending | filled | cancelled | rejected
  mode        String   @default("paper") // paper | live
  tcbsOrderId String?
  placedAt    DateTime  @default(now())
  filledAt    DateTime?
  tradeId     Int?
  trade       Trade?    @relation(fields: [tradeId], references: [id])
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  owner     Boolean  @default(false) // chủ app: Telegram + TCBS + watcher + NAV/risk ở Setting
  navVnd    Float? // vốn riêng (user khác owner); null = mặc định
  riskPct   Float?
  watchlist String[] @default([])
  createdAt DateTime @default(now())
  trades    Trade[]
  // Telegram riêng (user khác owner — owner dùng TELEGRAM_CHAT_ID): liên kết qua /start <code>
  tgChatId   String?   @unique
  tgLinkCode String?   @unique
  // Loại thông báo nhận qua Telegram riêng + thông báo đẩy (web push)
  alertKinds String[]  @default(["signal", "sector", "stop", "target", "system"])
  // Tắt đẩy là của tài khoản (mọi thiết bị): false → xóa hết PushSub, resync không hồi sinh
  pushEnabled Boolean   @default(true)
  pushSubs   PushSub[]
  // Mã PIN 6 số (scrypt salt:hash) — vào trang cá nhân; sai 5 lần khóa 15 phút
  pinHash      String?
  pinFails     Int       @default(0)
  pinLockUntil DateTime?
  sessionVer   Int       @default(0) // tăng khi đổi/xóa PIN → cookie thiết bị cũ hết hiệu lực
  persona      String? // giọng thông báo (lib/persona.ts) — null = tự gán phong cách chưa ai dùng
}

/// Web Push subscription — mỗi trình duyệt/thiết bị 1 dòng
model PushSub {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Trade {
  id          Int       @id @default(autoincrement())
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id])
  symbolId    Int
  symbol      Symbol    @relation(fields: [symbolId], references: [id])
  qty         Int
  entryPrice  Float
  exitPrice   Float?
  stopPrice   Float? // watcher dùng để cắt lỗ
  targetPrice Float?
  pnl         Float? // net sau phí+thuế
  status      String    @default("open") // open | closed
  exitReason  String? // stop | target | trailing | time-stop | manual
  signalId    Int?
  signal      Signal?   @relation(fields: [signalId], references: [id])
  tags        String?
  note        String?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  orders      Order[]

  @@index([userId, status])
}

model Position {
  id          Int      @id @default(autoincrement())
  symbolId    Int      @unique
  symbol      Symbol   @relation(fields: [symbolId], references: [id])
  qty         Int
  sellableQty Int
  avgPrice    Float
  syncedAt    DateTime @default(now())
}

model BacktestRun {
  id            Int      @id @default(autoincrement())
  strategyType  String
  params        String
  universe      String
  periodStart   String
  periodEnd     String
  metrics       String // JSON
  equity        String // JSON
  trades        String // JSON
  createdAt     DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model CorporateAction {
  id        Int      @id @default(autoincrement())
  symbolId  Int
  exDate    String // YYYY-MM-DD phiên GDKHQ
  factor    Float // hệ số điều chỉnh giá (fresh/stored)
  kind      String // cash | split
  note      String?
  createdAt DateTime @default(now())

  @@unique([symbolId, exDate])
}

model DataGap {
  id        Int      @id @default(autoincrement())
  symbolId  Int?
  date      String
  reason    String
  createdAt DateTime @default(now())
}

// Thông báo nổi trên web — ghi song song Telegram từ cron (watcher, scan, positions-report...)
model Alert {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  kind      String // signal | sector | stop | target | positions | system
  level     String   @default("info") // info | success | warn | danger
  title     String
  body      String   @default("")
  ticker    String?
  userId    Int? // null = mọi người
  @@index([userId, id])
}
