# vn-trader prod env — VPS 36.50.55.41 (không commit — .env* đã gitignore)
# DB = database `vntrader` trong infra-postgres chung, host = alias `postgres`
# trên network infra_internal. Tạo 1 lần:
#   docker exec infra-postgres-1 psql -U postgres -c \
#     "CREATE USER vntrader WITH PASSWORD '<pass>'; CREATE DATABASE vntrader OWNER vntrader;"
DATABASE_URL="postgresql://vntrader:<db_password>@postgres:5432/vntrader"
# Neon cũ — chỉ cần cho migrate-db.sh (pg_dump nguồn), xóa sau khi migrate xong
NEON_URL=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Webhook qua Caddy: setWebhook → https://<domain>/api/telegram/webhook.
# false = không polling trong container.
TELEGRAM_POLLING=false
TELEGRAM_WEBHOOK_SECRET=""
#TELEGRAM_BOT_USERNAME=""

# TCBS OpenAPI (phase 3 — trống = tính năng tắt)
TCBS_API_KEY=""
#TCBS_ACCOUNT_NO=""

NAV_VND="500000000"
RISK_PCT="0.01"
PAPER_TRADING="true"
KILL_SWITCH="false"

CRON_SECRET=""
# cron-job.org đã tắt — VPS dùng node-cron in-process, key chỉ còn để quản lý job cũ
#CRON_JOB_API_KEY=""
AI_OPENAI_API_KEY=""
